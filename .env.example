TMDB_API_KEY=your_tmdb_api_key_here
RAWG_API_KEY=your_rawg_api_key_here
GOOGLE_BOOKS_KEY=your_google_books_api_key_here

# Last.fm (música: "tocando agora" + gravação na biblioteca).
# Podem ser definidos aqui OU pela tela Settings (a UI tem prioridade).
# Troque para 1 depois de preencher a key e o usuário.
LASTFM_ENABLED=0
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USER=your_lastfm_username

PORT=3000
DATA_DIR=./data

# Fuso usado para fechar o diário diário de livros e jogos (padrão: São Paulo).
SHELF_TIMEZONE=America/Sao_Paulo

# Hosts HTTPS extras aceitos pelo proxy de capas, separados por vírgula.
# Os provedores nativos (TMDB, RAWG, Google Books, Steam e Last.fm) já vêm liberados.
IMG_PROXY_ALLOWED_HOSTS=

# Snapshots integrais e verificados do SQLite. Em Docker, monte BACKUP_DIR em
# um volume persistente e inclua esse diretório no backup externo do servidor.
BACKUP_ENABLED=1
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_SAFETY=5

# Limpa apenas o JSON bruto dos eventos antigos. Feed, estatísticas e histórico
# normalizado continuam guardados sem prazo. Use 0 para desativar o job.
ACTIVITY_RETENTION_ENABLED=1
ACTIVITY_RAW_RETENTION_DAYS=30
ACTIVITY_RETENTION_INTERVAL_HOURS=24

# IsThereAnyDeal (preços dos jogos de PC no backlog).
# Podem ser definidos aqui OU pela tela Settings (a UI tem prioridade).
ITAD_ENABLED=0
ITAD_API_KEY=your_isthereanydeal_api_key_here
ITAD_COUNTRY=BR

# Steam (backlog bidirecional: wishlist da Steam <-> backlog do Shelf).
# Mexe SÓ no backlog — o que já foi jogado continua vindo do Playnite.
# Podem ser definidos aqui OU pela tela Integrações (a UI tem prioridade).
# Ler a wishlist só exige STEAM_ID com o perfil público; a API key é opcional,
# e serve para não enviar à wishlist um jogo que você já comprou. Escrever
# exige os dois cookies da loja (Application > Cookies > store.steampowered.com
# no navegador logado).
STEAM_ENABLED=0
STEAM_ID=your_steamid64_here
STEAM_API_KEY=your_steam_web_api_key_here
STEAM_LOGIN_SECURE=
STEAM_SESSION_ID=
STEAM_SYNC_MODE=both
STEAM_SYNC_REMOVALS=0
